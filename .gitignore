# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

!.env.example

# Never publish local/private data or archives.
/.openai/
/docs/provenance/
/evidence/
/output/
*.sqlite
*.sqlite3
*.db
.dev.vars*
/public/data/source-inventory.json
# Local map server data (npm run local) and private transition plans. Scripts
# resolve .local/ and output/ from the working directory, so match them anywhere.
.local/
output/
# Database exports and attendee lists never belong in the repository.
/*.sql
/*.csv
# TypeScript incremental build state
*.tsbuildinfo
